@startuml
left to right direction
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 80
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #444444
}

actor "Guest" as Guest
actor "Player" as Player
actor "Admin" as Admin

rectangle "Umasearch" {

  usecase "UC-01\nЗареєструватися" as UC01
  usecase "UC-02\nУвійти" as UC02

  usecase "UC-03\nШукати умок" as UC03
  usecase "UC-04\nШукати картки" as UC04
  usecase "UC-05\nПереглянути видачу пошуку" as UC05
  usecase "UC-19\nОтримати trainer_id гравця" as UC19

  usecase "UC-06\nВиставити умку" as UC06
  usecase "UC-07\nВиставити картку" as UC07
  usecase "UC-08\nЗмінити рентал" as UC08
  usecase "UC-09\nЗняти рентал" as UC09

  usecase "UC-10\nПоскаржитися на гравця" as UC10

  usecase "UC-11\nНаповнювати довідники" as UC11
  usecase "UC-12\nВерифікувати Player" as UC12
  usecase "UC-13\nПереглянути скарги" as UC13
  usecase "UC-14\nПовернути зі flagged" as UC14
}

' --- Асоціації акторів ---
Guest --> UC01
Guest --> UC03
Guest --> UC04

Player --> UC02
Player --> UC03
Player --> UC04
Player --> UC06
Player --> UC07
Player --> UC08
Player --> UC09
Player --> UC10

Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14

' --- Узагальнення акторів ---
Admin --|> Player

' --- include ---
UC03 ..> UC05 : <<include>>
UC04 ..> UC05 : <<include>>

' --- extend ---
UC19 ..> UC05 : <<extend>>\n[користувач авторизований]

@enduml
