@startuml
title Umasearch: Use Case Diagram
left to right direction
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 70
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #444444
}

actor "Guest" as Guest
actor "Player" as Player
actor "Admin" as Admin

rectangle "Umasearch" {

  usecase "UC-01\nЗареєструватися" as UC01
  usecase "UC-02\nУвійти" as UC02

  usecase "UC-20\nШукати гравців" as UC20 <<abstract>>
  usecase "UC-03\nШукати умок" as UC03
  usecase "UC-04\nШукати картки" as UC04
  usecase "UC-05\nЗастосувати правила видачі" as UC05
  usecase "UC-18\nПоказати «Нічого не знайдено»" as UC18
  usecase "UC-19\nПоказати trainer_id" as UC19

  usecase "UC-06\nВиставити умку" as UC06
  usecase "UC-07\nВиставити картку" as UC07
  usecase "UC-08\nЗмінити рентал" as UC08
  usecase "UC-09\nЗняти рентал" as UC09
  usecase "UC-16\nВалідувати параметри рентала" as UC16

  usecase "UC-10\nПоскаржитися" as UC10
  usecase "UC-17\nПозначити flagged" as UC17

  usecase "UC-11\nНаповнювати довідники" as UC11
  usecase "UC-12\nВерифікувати Player" as UC12
  usecase "UC-13\nПереглянути скарги" as UC13
  usecase "UC-14\nПовернути зі flagged" as UC14
  usecase "UC-15\nПеревірити роль Admin" as UC15
}

' --- Асоціації акторів ---
Guest --> UC01
Guest --> UC03
Guest --> UC04

Player --> UC02
Player --> UC03
Player --> UC04
Player --> UC06
Player --> UC07
Player --> UC08
Player --> UC09
Player --> UC10

UC02 <-- Admin
UC11 <-- Admin
UC12 <-- Admin
UC13 <-- Admin
UC14 <-- Admin

' --- Узагальнення (UC-20 абстрактний) ---
UC03 --|> UC20
UC04 --|> UC20

' --- include ---
UC03 ..> UC05 : <<include>>
UC04 ..> UC05 : <<include>>

UC06 ..> UC16 : <<include>>
UC07 ..> UC16 : <<include>>
UC08 ..> UC16 : <<include>>

UC06 ..> UC02 : <<include>>
UC07 ..> UC02 : <<include>>
UC08 ..> UC02 : <<include>>
UC09 ..> UC02 : <<include>>
UC10 ..> UC02 : <<include>>

UC11 ..> UC15 : <<include>>
UC12 ..> UC15 : <<include>>
UC13 ..> UC15 : <<include>>
UC14 ..> UC15 : <<include>>

' --- extend ---
UC18 ..> UC05 : <<extend>>\n[видача порожня]
UC19 ..> UC05 : <<extend>>\n[користувач авторизований]
UC17 ..> UC10 : <<extend>>\n[reports_count ≥ 5]

@enduml
