erDiagram
    Player {
        uuid id PK
        string email UK
        string password
        string trainer_id UK
        string trainer_name
        string verification_status
        int reports_count
        string role
    }
    Umamusume {
        uuid id PK
        string name
        string icon
    }
    SupportCard {
        uuid id PK
        string name
        string icon
        string card_type
        string rarity
    }
    Factor {
        uuid id PK
        string name
        int star_rate
        string category
    }
    SharedUma {
        uuid id PK
        uuid player_id FK
        uuid umamusume_id FK
        string rank
        int speed_stat
        int stamina_stat
        int power_stat
        int guts_stat
        int wit_stat
        datetime created_at
        datetime updated_at
    }
    SharedCard {
        uuid id PK
        uuid player_id FK
        uuid support_card_id FK
        int level
        int limit_break
        datetime created_at
        datetime updated_at
    }
    shared_uma_factors {
        uuid shared_uma_id PK, FK
        uuid factor_id PK, FK
    }
    Report {
        uuid reporter_id FK
        uuid reported_id FK
    }

    Player ||..o{ SharedUma : "has"
    Player ||..o{ SharedCard : "has"
    Umamusume ||..o{ SharedUma : "is used in"
    SupportCard ||..o{ SharedCard : "is used in"
    SharedUma ||--o{ shared_uma_factors : "has"
    Factor ||--o{ shared_uma_factors : "has"
    Player ||..o{ Report : "reports"
    Player ||..o{ Report : "is reported in"