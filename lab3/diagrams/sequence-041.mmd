sequenceDiagram
    autonumber
    actor A as Player A<br/>(скаржник)
    participant RS as ReportService
    participant REL as Player–Player<br/>«скаржиться на»
    participant PB as Player B<br/>(відповідач)


    Note over A,PB: SC-041 · REP-01 · UC-10<br/>Дано: B.reports_count = 2<br/>Коли одна зі складових операції не вдається
    A->>+RS: submitReport(reportedPlayerId = B)
    alt A = B (REP-02, SC-043)
        RS->>RS: isSelfReport(A, B) = true
        RS-->>A: reportRejected (показується помилка)
    else A ≠ B, пара A — B уже є (REP-02, SC-042)
        RS->>RS: isSelfReport(A, B) = false
        RS->>+REL: existsPair(A, B)
        REL-->>-RS: true
        RS-->>A: reportRejected (показується помилка)
    else A ≠ B, пари A — B немає (цей сценарій)
        RS->>RS: isSelfReport(A, B) = false
        RS->>+REL: existsPair(A, B)
        REL-->>-RS: false
        rect rgba(120, 160, 255, 0.15)
            Note over RS,PB: Одна неподільна операція (REP-01)
            RS->>RS: beginTransaction()
            alt збереження пари не вдалося
                RS->>+REL: savePair(A, B)
                REL--xRS: збій збереження пари
                deactivate REL
                RS->>RS: rollback()
                Note over REL,PB: пару A — B не збережено<br/>B.reports_count = 2 без змін
            else пару збережено, збільшення лічильника не вдалося
                RS->>+REL: savePair(A, B)
                REL-->>-RS: ok
                RS->>+PB: incrementReportsCount(B)
                PB--xRS: збій збільшення reports_count
                deactivate PB
                RS->>RS: rollback()
                Note over REL,PB: збережену пару скасовано<br/>B.reports_count = 2 без змін
            end
        end
        RS-->>A: reportFailed (жодна зі змін не застосована)
    end
    deactivate RS